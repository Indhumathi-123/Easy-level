class Solution {
    public int majorityElement(int[] nums) {
        // Step 1: Initialize the candidate and the vote counter
        int candidate = nums[0];
        int count = 0;
        
        // Step 2: Loop through the array using a standard index
        for (int i = 0; i < nums.length; i++) {
            
            // Step 3: If the current vote count is 0, pick the current element as the new candidate
            if (count == 0) {
                candidate = nums[i];
            }
            
            // Step 4: If the current element matches the candidate, add a vote. 
            // Otherwise, subtract a vote.
            if (nums[i] == candidate) {
                count++;
            } else {
                count--;
            }
        }
        
        // Step 5: Return the winning candidate
        return candidate;
    }
}
